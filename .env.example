# --- The vault: ONE folder with all your notes (mounted read-only) ---
VAULT_PATH=C:/Users/Leito/Documents/Learning/SW-ML-AI Engineering
# the only folder P4 writes to (inside the vault)
RESEARCH_OUTPUT_DIR=99 - Research Agent
# folders never indexed; notes tagged #private are skipped too
VAULT_EXCLUDE=.obsidian,_private
# Send vault excerpts to the Google AI Studio free tier (Gemma 4) through P0? Enabled by the user (2026-10-06).
# Excluded folders/tags never leave the machine and Presidio redacts PII first. false = local models only (ADR-9)
VAULT_CLOUD_CONSENT=true

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=research-dev-only
QDRANT_URL=http://localhost:6333
CHECKPOINTER_DSN=postgresql://research:research@localhost:5432/research
LLM_GATEWAY_URL=http://localhost:8080/v1
LLM_GATEWAY_KEY=change-me

# --- External search (no Tavily, ADR-7) ---
SEARXNG_URL=http://localhost:8888
# OPENALEX_API_KEY=            # free key with daily allowance
# GITHUB_TOKEN=                # optional: higher rate limit for repo status checks
# EXA_API_KEY=                 # optional extra provider, off by default

# LANGFUSE_PUBLIC_KEY= / LANGFUSE_SECRET_KEY=   (Langfuse Cloud Hobby, optional)
MLFLOW_TRACKING_URI=file:./mlruns
